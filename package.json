{
  "name": "deviate",
  "version": "1.0.0",
  "private": true,
  "description": "A daily monochrome timeline-guessing game.",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-puzzles.mjs",
    "generate:today": "node scripts/generate-puzzles.mjs --date $(date -u +%F)",
    "check": "node --check app.js && node --check scripts/generate-puzzles.mjs"
  }
}
